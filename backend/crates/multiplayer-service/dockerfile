FROM rust:1.94 AS builder
WORKDIR /app

COPY . .

RUN cargo build --release -p multiplayer-service

# ---- runtime stage ----
FROM debian:bookworm-slim
WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/multiplayer-service /app/multiplayer-service

EXPOSE 3000
CMD ["./multiplayer-service"]
